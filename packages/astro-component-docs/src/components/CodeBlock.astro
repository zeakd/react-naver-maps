---
import { Code } from 'astro:components';

interface Props {
  code: string;
  lang?: string;
  title?: string;
}

const { code, lang = 'tsx', title } = Astro.props;
---

<div class="acd-code-block">
  {title && <div class="acd-code-title">{title}</div>}
  <Code code={code} lang={lang} themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} />
</div>

<style>
  .acd-code-block {
    border: 1px solid var(--acd-border, #e2e8f0);
    border-radius: 10px;
    overflow: hidden;
    margin: 1rem 0;
  }

  .acd-code-title {
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--acd-text-muted, #6e767e);
    background: var(--acd-bg-subtle, #f6f7f8);
    border-bottom: 1px solid var(--acd-border, #e4e7ea);
  }

  .acd-code-block :global(pre) {
    margin: 0;
    border-radius: 0;
  }
</style>
