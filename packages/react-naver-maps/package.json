{
  "name": "react-naver-maps",
  "version": "0.3.0",
  "description": "React components for Naver Maps JavaScript API v3",
  "keywords": [
    "maps",
    "naver",
    "naver-maps",
    "navermaps",
    "react"
  ],
  "homepage": "https://zeakd.github.io/react-naver-maps",
  "bugs": "https://github.com/zeakd/react-naver-maps/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeakd/react-naver-maps"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/core/react-naver-maps.d.ts",
      "default": "./dist/core/react-naver-maps.js"
    },
    "./addons": {
      "types": "./dist/addons/index.d.ts",
      "default": "./dist/addons/index.js"
    },
    "./geocoder": {
      "types": "./dist/geocoder/index.d.ts",
      "default": "./dist/geocoder/index.js"
    },
    "./visualization": {
      "types": "./dist/visualization/index.d.ts",
      "default": "./dist/visualization/index.js"
    },
    "./drawing": {
      "types": "./dist/drawing/index.d.ts",
      "default": "./dist/drawing/index.js"
    },
    "./panorama": {
      "types": "./dist/panorama/index.d.ts",
      "default": "./dist/panorama/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scenarios": "playwright test --config e2e/scenarios.config.ts",
    "compare:scenarios": "node e2e/compare.ts",
    "compare:types": "node e2e/compare-types.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test:visual": "npx playwright test --config e2e/playwright.config.ts visual.spec.ts",
    "test:examples": "RNM_SITE=build npx playwright test --config e2e/playwright.config.ts examples.spec.ts",
    "test:visual:update": "npx playwright test --config e2e/playwright.config.ts --update-snapshots",
    "test:visual:cache": "TILE_CACHE=update npx playwright test --config e2e/playwright.config.ts --update-snapshots",
    "test:visual:cached": "TILE_CACHE=use npx playwright test --config e2e/playwright.config.ts",
    "verify:frameworks": "node e2e/verify-frameworks.ts",
    "check:package": "publint && attw --pack . --profile esm-only",
    "check:e2e": "tsc -p e2e/tsconfig.json"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/navermaps": "^3.9.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@types/navermaps": "^3.9.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/navermaps": {
      "optional": true
    }
  }
}
