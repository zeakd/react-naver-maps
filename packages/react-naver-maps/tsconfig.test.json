{
  // vitest typecheck 전용. 메인 tsconfig.json은 빌드 산출물을 위해 spec을 exclude하므로,
  // 타입 테스트(event-types.spec.ts의 expectTypeOf)를 검사하려면 별도 구성이 필요하다.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "rootDir": ".",
    // 문서와 코드를 맞대는 검사(naver-map-docs.spec.ts)가 파일을 읽는다.
    "types": ["navermaps", "node"]
  },
  // 표가 공개 prop 을 빠짐없이 적었는지를 컴파일로 본다.
  "include": ["src/**/*.spec.ts", "src/binding/__tests__/extra-sdk-options.spec.tsx"],
  "exclude": ["node_modules", "dist"]
}
