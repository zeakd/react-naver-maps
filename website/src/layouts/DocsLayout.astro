---
// 문서 페이지 틀: 영역(시작하기·예제·API)별 사이드바, 본문, "이 페이지" 목차, GitHub 에서 고치기, 이전/다음.
import { getCollection } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import { apiNav, docsNav, exampleCategories, GITHUB, REACT_EXAMPLES, sectionOf, type Section } from '../nav';

interface Props {
  title: string;
  slug: string;
  headings?: MarkdownHeading[];
  editPath?: string;
  description?: string;
  /** 사이드바에서 현재 위치로 표시할 항목(문서가 아닌 페이지용, 예: 'examples') */
  section?: Section;
}

const { title, slug, headings = [], editPath, description } = Astro.props;
const section = Astro.props.section ?? sectionOf(slug);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = (await getCollection('docs')).filter((d) => !d.data.hidden);
const byId = new Map(all.map((d) => [d.id, d]));
const href = (id: string) => `${base}/${id}/`;
const titleOf = (id: string) => byId.get(id)?.data.menuName ?? byId.get(id)?.data.title ?? id;

type Item = { id: string; label: string; href: string };
type Group = { label: string; items: Item[]; collapsible?: boolean; open?: boolean };

// nav.ts 가 없는 문서를 가리키면 사이드바에서 조용히 빠지지 않게 빌드를 멈춘다.
const toItems = (ids: string[]) =>
  ids.map((id) => {
    if (!byId.has(id)) throw new Error(`[nav] 없는 문서: ${id} (website/src/nav.ts)`);
    return { id, label: titleOf(id), href: href(id) };
  });
let groups: Group[] = [];
if (section === 'docs') groups = docsNav.map((g) => ({ label: g.label, items: toItems(g.items) }));
if (section === 'api') groups = apiNav.map((g) => ({ label: g.label, items: toItems(g.items) }));
if (section === 'examples') {
  const sorted = (cat: string) => all.filter((d) => d.data.category === cat).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)).map((d) => d.id);
  groups = [
    { label: '예제', items: [{ id: 'examples', label: '모든 예제', href: `${base}/examples/` }] },
    { label: 'React 예제', items: toItems(sorted(REACT_EXAMPLES)) },
    ...exampleCategories.map((c) => {
      const items = toItems(sorted(c.id));
      return { label: c.label, items, collapsible: true, open: items.some((i) => i.id === slug) };
    }),
  ];
}
const flat = groups.flatMap((g) => g.items).filter((i) => i.id !== 'examples');
const at = flat.findIndex((i) => i.id === slug);
const prev = at > 0 ? flat[at - 1] : null;
const next = at >= 0 && at < flat.length - 1 ? flat[at + 1] : null;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const officialStart = groups.findIndex((g) => g.collapsible);
---

<BaseLayout title={title} description={description} section={section}>
  <button slot="menu-button" class="docs-menu" type="button" data-docs-menu aria-label="문서 목록 열기" aria-expanded="false">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
  </button>
  <div class="docs">
    <aside class="docs-side" data-docs-side aria-label="문서 목록">
      {groups.map((g, i) => (
        <>
          {i === officialStart && <p class="docs-side-sub">공식 예제</p>}
          {g.collapsible ? (
            <details class="docs-group" open={g.open}>
              <summary>{g.label}<em>{g.items.length}</em></summary>
              {g.items.map((it) => <a href={it.href} aria-current={it.id === slug ? 'page' : undefined}>{it.label}</a>)}
            </details>
          ) : (
            <div class="docs-group">
              <p class="docs-group-label">{g.label}</p>
              {g.items.map((it) => <a href={it.href} aria-current={it.id === slug ? 'page' : undefined}>{it.label}</a>)}
            </div>
          )}
        </>
      ))}
    </aside>
    <div class="docs-scrim" data-docs-scrim></div>
    <main class="docs-main">
      <article class="prose" data-pagefind-body>
        <slot />
      </article>
      <div class="docs-meta">
        {editPath && <a href={`${GITHUB}/edit/main/${editPath}`} target="_blank" rel="noopener">GitHub 에서 이 페이지 고치기</a>}
        <a href={`${GITHUB}/issues/new`} target="_blank" rel="noopener">문제 알리기</a>
      </div>
      {(prev || next) && (
        <nav class="docs-pager" aria-label="이전 다음 문서">
          {prev ? <a href={prev.href}><small>이전</small>{prev.label}</a> : <span></span>}
          {next && <a class="next" href={next.href}><small>다음</small>{next.label}</a>}
        </nav>
      )}
    </main>
    <nav class="docs-toc" aria-label="이 페이지">
      {toc.length > 0 && (
        <>
          <p>이 페이지</p>
          {toc.map((h) => <a href={`#${h.slug}`} class={h.depth === 3 ? 'sub' : undefined}>{h.text}</a>)}
        </>
      )}
    </nav>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var btn = document.querySelector('[data-docs-menu]');
    var side = document.querySelector('[data-docs-side]');
    var scrim = document.querySelector('[data-docs-scrim]');
    function set(open) {
      side.classList.toggle('open', open);
      scrim.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
    }
    if (btn) btn.addEventListener('click', function () { set(!side.classList.contains('open')); });
    if (scrim) scrim.addEventListener('click', function () { set(false); });
    // 현재 문서가 사이드바 아래쪽이면 보이게 스크롤한다.
    var cur = side && side.querySelector('[aria-current="page"]');
    if (cur && cur.offsetTop > side.clientHeight - 80) side.scrollTop = cur.offsetTop - side.clientHeight / 3;
    // 목차: 지금 읽는 절을 표시한다.
    var links = Array.prototype.slice.call(document.querySelectorAll('.docs-toc a'));
    if (!links.length || !('IntersectionObserver' in window)) return;
    var map = new Map(links.map(function (a) { return [decodeURIComponent(a.hash.slice(1)), a]; }));
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        links.forEach(function (a) { a.classList.remove('active'); });
        var a = map.get(e.target.id); if (a) a.classList.add('active');
      });
    }, { rootMargin: '-80px 0px -70% 0px' });
    map.forEach(function (_, id) { var el = document.getElementById(id); if (el) io.observe(el); });
  })();
</script>

<style is:global>
  .docs {
    display: grid;
    grid-template-columns: 272px minmax(0, 1fr) 232px;
    max-width: 1440px;
    margin: 0 auto;
  }
  .docs-menu {
    display: none;
    width: 36px;
    height: 36px;
    place-items: center;
    border: 0;
    background: none;
    color: var(--text-2);
    border-radius: 8px;
    cursor: pointer;
  }
  .docs-side {
    position: sticky;
    top: var(--header-h);
    align-self: start;
    height: calc(100vh - var(--header-h));
    overflow-y: auto;
    padding: 24px 14px 48px 24px;
    border-right: 1px solid var(--line);
    font-size: 14.5px;
    overscroll-behavior: contain;
  }
  .docs-group {
    margin-bottom: 18px;
  }
  .docs-group-label {
    margin: 0 8px 6px;
    font-weight: 700;
    font-size: 13px;
    color: var(--text);
  }
  .docs-side-sub {
    margin: 4px 8px 8px;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-3);
  }
  details.docs-group {
    margin-bottom: 2px;
  }
  .docs-group summary {
    display: flex;
    align-items: center;
    padding: 5px 8px;
    border-radius: 6px;
    color: var(--text-2);
    cursor: pointer;
    list-style: none;
  }
  .docs-group summary::-webkit-details-marker {
    display: none;
  }
  .docs-group summary em {
    margin-left: auto;
    font: 500 12px var(--mono);
    font-style: normal;
    color: var(--text-3);
  }
  .docs-group summary::after {
    content: '';
    width: 6px;
    height: 6px;
    margin-left: 10px;
    border-right: 1.5px solid var(--text-3);
    border-bottom: 1.5px solid var(--text-3);
    transform: rotate(-45deg);
    transition: transform 0.15s;
  }
  .docs-group[open] summary::after {
    transform: rotate(45deg);
  }
  .docs-group summary:hover {
    background: var(--bg-soft);
    color: var(--text);
  }
  .docs-group a {
    display: block;
    padding: 5px 8px;
    border-radius: 6px;
    color: var(--text-2);
    line-height: 1.45;
  }
  details.docs-group a {
    padding-left: 20px;
    font-size: 14px;
  }
  .docs-group a:hover {
    background: var(--bg-soft);
    color: var(--text);
  }
  .docs-group a[aria-current='page'] {
    background: var(--brand-soft);
    color: var(--brand-text);
    font-weight: 600;
  }
  .docs-main {
    min-width: 0;
    max-width: 880px;
    padding: 40px 48px 72px;
  }
  .docs-meta {
    display: flex;
    gap: 20px;
    margin-top: 56px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  .docs-meta a {
    color: var(--brand-text);
  }
  .docs-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 24px;
  }
  .docs-pager a {
    display: flex;
    flex-direction: column;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 10px;
    font-weight: 650;
  }
  .docs-pager a:hover {
    border-color: var(--brand);
  }
  .docs-pager a.next {
    text-align: right;
    grid-column: 2;
  }
  .docs-pager small {
    font-weight: 500;
    font-size: 12.5px;
    color: var(--text-3);
  }
  .docs-toc {
    position: sticky;
    top: var(--header-h);
    align-self: start;
    max-height: calc(100vh - var(--header-h));
    overflow-y: auto;
    padding: 40px 20px 40px 8px;
    display: flex;
    flex-direction: column;
    gap: 7px;
    font-size: 13.5px;
  }
  .docs-toc p {
    margin: 0 0 4px;
    font-weight: 700;
    font-size: 13px;
  }
  .docs-toc a {
    color: var(--text-3);
    line-height: 1.45;
  }
  .docs-toc a.sub {
    padding-left: 12px;
  }
  .docs-toc a:hover,
  .docs-toc a.active {
    color: var(--brand-text);
  }
  .docs-scrim {
    display: none;
  }
  @media (max-width: 1240px) {
    .docs {
      grid-template-columns: 260px minmax(0, 1fr);
    }
    .docs-toc {
      display: none;
    }
  }
  @media (max-width: 860px) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
    }
    .docs-menu {
      display: grid;
    }
    .docs-side {
      position: fixed;
      z-index: 50;
      top: var(--header-h);
      left: 0;
      width: min(300px, 86vw);
      background: var(--bg);
      transform: translateX(-102%);
      transition: transform 0.25s ease;
    }
    .docs-side.open {
      transform: none;
      box-shadow: 20px 0 40px -20px #0000004d;
    }
    .docs-scrim.open {
      display: block;
      position: fixed;
      inset: var(--header-h) 0 0;
      z-index: 45;
      background: #0b0d0f4d;
    }
    .docs-main {
      padding: 28px 16px 56px;
    }
  }
</style>
