---
// 모든 문서 페이지. 예제 페이지는 frontmatter(official·changes·limits·additions)를 같은 자리에 그린다.
import { getCollection, render } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import DocsLayout from '../layouts/DocsLayout.astro';
import Inline from '../components/Inline.astro';
import { exampleCategories, REACT_EXAMPLES } from '../nav';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isExample = entry.id.startsWith('examples/');
const isReact = d.category === REACT_EXAMPLES;
const category = exampleCategories.find((c) => c.id === d.category)?.label;
const extra: MarkdownHeading[] = [];
if (d.changes?.length) extra.push({ depth: 2, slug: 'changes', text: 'React로 옮기며 바꾼 점' });
if (d.additions?.length) extra.push({ depth: 2, slug: 'additions', text: '공식 예제에 더한 것' });
---

<DocsLayout title={d.title} slug={entry.id} headings={[...headings, ...extra]} editPath={entry.filePath ? `website/${entry.filePath}` : undefined}>
  {isExample && (
    <p class="ex-crumb">
      <a href={`${base}/examples/`}>예제</a>
      <span>/</span>
      {isReact ? <a href={`${base}/examples/#react`}>React 예제</a> : <a href={`${base}/examples/#official`}>공식 예제</a>}
      {category && <><span>/</span>{category}</>}
    </p>
  )}
  <h1>{d.title}</h1>
  {d.official && (
    <p class="ex-badges">
      <span class="ex-badge">공식 예제 대응</span>
      <a href={d.official} target="_blank" rel="noopener">네이버 공식 예제 보기 ↗</a>
    </p>
  )}
  {isReact && <p class="ex-badges"><span class="ex-badge react">React 예제</span><span class="ex-badge-note">React 앱에서 자주 사용하는 예제</span></p>}

  <Content />

  {d.changes && d.changes.length > 0 && (
    <>
      <h2 id="changes">React로 옮기며 바꾼 점</h2>
      <table class="ex-changes">
        <thead><tr><th>네이버 공식 예제</th><th>이 예제</th></tr></thead>
        <tbody>
          {d.changes.map((c) => <tr><td><Inline text={c.official} /></td><td><Inline text={c.react} /></td></tr>)}
        </tbody>
      </table>
      {d.limits && d.limits.length > 0 && (
        <div class="ex-limits">
          <p class="ex-limits-h">다르게 동작하거나 옮기지 못한 점</p>
          <ul>{d.limits.map((l) => <li><Inline text={l} /></li>)}</ul>
        </div>
      )}
    </>
  )}
  {d.additions && d.additions.length > 0 && (
    <>
      <h2 id="additions">공식 예제에 더한 것</h2>
      <ul class="ex-additions">{d.additions.map((a) => <li><Inline text={a} /></li>)}</ul>
    </>
  )}
</DocsLayout>

<style is:global>
  .ex-crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 10px;
    font-size: 13.5px;
    color: var(--text-3);
  }
  .ex-crumb a {
    color: var(--brand-text);
  }
  .ex-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin: -2px 0 20px !important;
    font-size: 14px;
  }
  .ex-badges a {
    color: var(--brand-text) !important;
    text-decoration: none !important;
  }
  .ex-badge {
    background: var(--brand-soft);
    color: var(--brand-text);
    font-weight: 600;
    font-size: 12.5px;
    padding: 3px 9px;
    border-radius: 6px;
  }
  .ex-badge.react {
    background: var(--text);
    color: var(--bg);
  }
  .ex-badge-note {
    color: var(--text-3);
  }
  .prose table.ex-changes {
    display: table;
  }
  .ex-changes td {
    width: 50%;
  }
  .ex-changes td:first-child {
    color: var(--text-2);
  }
  .ex-changes td:last-child {
    font-weight: 550;
  }
  .ex-limits {
    margin: 0 0 16px;
    padding: 14px 16px 6px;
    border-radius: 10px;
    background: var(--bg-soft);
    font-size: 14.5px;
  }
  .ex-limits-h {
    margin: 0 0 6px !important;
    font-weight: 650;
  }
</style>
