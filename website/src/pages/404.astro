---
// 없는 주소. 같은 틀(위쪽 막대·검색)을 두고 갈 만한 곳으로 잇는다.
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="페이지를 찾을 수 없습니다" description="페이지를 찾을 수 없습니다">
  <main class="nf">
    <p class="nf-code">404</p>
    <h1>페이지를 찾을 수 없습니다</h1>
    <p class="nf-lede">주소가 바뀌었거나 없는 문서입니다. 찾던 내용을 검색하거나 아래에서 다시 시작하세요.</p>
    <div class="nf-actions">
      <button class="btn primary" type="button" data-search-open>문서 검색</button>
      <a class="btn" href={`${base}/`}>홈</a>
      <a class="btn" href={`${base}/examples/`}>예제</a>
      <a class="btn" href={`${base}/guides/introduction/`}>시작하기</a>
    </div>
  </main>
</BaseLayout>

<style>
  .nf {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 120px 24px 80px;
    text-align: center;
  }
  .nf-code {
    margin: 0;
    font: 700 88px/1 var(--mono);
    letter-spacing: -0.04em;
    background: linear-gradient(100deg, #21a865, #1fa3a3);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .nf h1 {
    margin: 18px 0 10px;
    font-size: 30px;
    letter-spacing: -0.03em;
  }
  .nf-lede {
    margin: 0 auto 28px;
    max-width: 460px;
    color: var(--text-2);
  }
  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
</style>
